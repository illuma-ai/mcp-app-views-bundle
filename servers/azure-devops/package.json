{
  "name": "@azure-devops/mcp",
  "version": "2.11.0",
  "mcpName": "microsoft.com/azure-devops",
  "description": "MCP server for interacting with Azure DevOps",
  "license": "MIT",
  "author": "Microsoft Corporation",
  "homepage": "https://github.com/microsoft/azure-devops-mcp",
  "bugs": "https://github.com/microsoft/azure-devops-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/azure-devops-mcp.git"
  },
  "type": "module",
  "bin": {
    "mcp-server-azuredevops": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -p \"'export const packageVersion = ' + JSON.stringify(require('./package.json').version) + ';\\n'\" > src/version.ts && prettier --write src/version.ts",
    "validate-tools": "tsc --noEmit && node scripts/build-validate-tools.js",
    "check-names": "node scripts/check-forbidden-names.cjs",
    "build": "npm run generate:views && tsc && shx chmod +x dist/*.js",
    "generate:views": "node bin/generate-views.mjs",
    "typecheck:views": "tsc -p src/views/web",
    "preview:views": "tsx preview/server.ts",
    "measure:views": "node bin/measure-views.mjs",
    "parity": "node bin/measure-views.mjs --parity",
    "parity:write": "node bin/measure-views.mjs --parity --write",
    "contrast": "node bin/measure-views.mjs --contrast",
    "prepare": "npm run build && husky",
    "watch": "tsc --watch",
    "inspect": "ALLOWED_ORIGINS=http://127.0.0.1:6274 npx @modelcontextprotocol/inspector@0.21.0 node dist/index.js",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "eslint": "eslint",
    "eslint-fix": "eslint --fix",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "clean": "shx rm -rf dist",
    "test": "jest",
    "pretest": "node bin/generate-views.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/logger": "^1.3.0",
    "@azure/msal-node": "^5.5.0",
    "@fluentui/react-components": "9.75.1",
    "@fluentui/react-icons": "2.0.345",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "azure-devops-extension-api": "^5.272.3",
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-node-api": "^15.1.2",
    "open": "^10.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "winston": "^3.18.3",
    "yargs": "^18.0.0",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "@azure/msal-node-extensions": "^5.3.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.27.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-extended": "^7.0.0",
    "lint-staged": "^17.0.0",
    "prettier": "3.9.5",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "**/*.(js|ts|jsx|tsx|json|css|md)": [
      "npm run format"
    ]
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "@azure/msal-node-extensions@5.3.5": true
  }
}
